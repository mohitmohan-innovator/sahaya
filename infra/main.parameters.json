{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "chatModelVersion": {
      "value": "${CHAT_MODEL_VERSION=2024-11-20}"
    },
    "chatDeploymentSku": {
      "value": "${CHAT_DEPLOYMENT_SKU=GlobalStandard}"
    },
    "embeddingDeploymentSku": {
      "value": "${EMBEDDING_DEPLOYMENT_SKU=Standard}"
    },
    "searchLocation": {
      "value": "${AZURE_SEARCH_LOCATION}"
    }
  }
}